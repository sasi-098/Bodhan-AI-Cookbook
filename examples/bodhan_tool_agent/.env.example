# Bodhan AI API Credentials
# Get your API keys at: https://console.bodhan.ai/
BODHAN_API_KEY=your_bodhan_api_key_placeholder
BODHAN_BASE_URL=https://api.bodhan.ai

# Optional model-specific keys (fallback to BODHAN_API_KEY if unset)
BODHAN_TRANSCRIBE_KEY=your_transcribe_key_placeholder
BODHAN_TRANSLATE_KEY=your_translate_key_placeholder
BODHAN_SPEAK_KEY=your_speak_key_placeholder
BODHAN_OCR_KEY=your_ocr_key_placeholder

# LLM Configuration (OpenAI-compatible endpoint for Task Agent planner)
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o
LLM_API_KEY=your_llm_api_key_placeholder

# Optional Settings
# BODHAN_MOCK=1  # Set to 1 to run with simulated mock responses without calling real APIs
